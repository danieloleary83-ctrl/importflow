# Copy this file to .env.local and fill in the real values.
# You get these from your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET - server only. Never put this in NEXT_PUBLIC_ variables.
# Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key, used by the AI Import page to read your screenshots.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key
